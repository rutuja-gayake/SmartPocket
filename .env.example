# SmartPocket Server Configuration
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Session Configuration
SESSION_SECRET=change-this-to-a-secure-random-64-character-string-in-production
SESSION_MAX_AGE_MS=604800000

# Security
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database
DB_FILE=data/smartpocket.db

# Optional Cloud AI Integration (Gemini / OpenAI)
# Leave empty to use local rule-based deterministic Pocket Advisor
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
