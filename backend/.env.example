# SmartPocket Server Configuration
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Session Configuration
SESSION_SECRET=change-this-to-a-secure-random-64-character-string-in-production
SESSION_MAX_AGE_MS=604800000

# Security
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database
DB_FILE=data/smartpocket.db

# Optional Cloud AI Integration (Groq / Gemini / OpenAI)
# Leave empty or set to 'none' to use the offline rule-based advisor
AI_PROVIDER=groq
AI_API_KEY=gsk_your_groq_api_key_here
AI_MODEL=llama-3.3-70b-versatile

