{
  "name": "smartpocket",
  "version": "1.0.0",
  "description": "SmartPocket — Student Budget & Savings Advisor",
  "type": "module",
  "main": "backend/src/server.js",
  "scripts": {
    "start": "node backend/src/server.js",
    "start:backend": "node backend/src/server.js",
    "start:frontend": "npm run dev --prefix frontend",
    "dev:backend": "node --watch backend/src/server.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "test": "node --test backend/tests/unit/*.test.js backend/tests/integration/*.test.js",
    "test:unit": "node --test backend/tests/unit/*.test.js",
    "test:integration": "node --test backend/tests/integration/*.test.js",
    "db:init": "node backend/scripts/init-db.js",
    "db:seed": "node backend/scripts/seed-db.js"
  },
  "keywords": [
    "pwa",
    "budget",
    "student-finance",
    "savings",
    "react",
    "vite",
    "sqlite"
  ],
  "author": "SmartPocket Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "otpauth": "^9.4.1",
    "qrcode": "^1.5.4"
  }
}
